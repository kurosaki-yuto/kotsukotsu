{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-app-name-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      // SAME database as the main app (database_name "your-app-name-db").
      // Run `wrangler d1 list` (or check the main app deploy) and paste the
      // real id below — it must match the main app's wrangler.jsonc.
      "binding": "DB",
      "database_name": "your-app-name-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    // SAME bucket as the main app (app/lib/server/files.ts) — file resources
    // uploaded via MCP land in the same place the app's /api/files reads from.
    { "binding": "FILES", "bucket_name": "your-app-name-files" }
  ],
  "vars": {
    "RT_URL": "https://your-app-name-rt.YOUR_SUBDOMAIN.workers.dev",
    // Main app — holds the VAPID keys, so phone pushes are a callback there.
    "PUSH_URL": "https://your-app-name.YOUR_SUBDOMAIN.workers.dev"
  },
  // Worker-to-worker fetches to *.workers.dev URLs are blocked by Cloudflare
  // (they 404 without ever reaching the target), so the push/realtime
  // callbacks go over service bindings instead of the public URLs above (the
  // URLs stay as vars because the bindings still need an absolute URL to
  // route the request path).
  // 型 (playbooks) の意味での検索に使う埋め込み (@cf/baai/bge-m3)。src/playbooks.ts
  "ai": { "binding": "AI" },
  "services": [
    { "binding": "APP", "service": "your-app-name" },
    { "binding": "RT", "service": "your-app-name-rt" }
  ],
  // Sweeps due-date reminders (scheduled() handler in src/index.ts) every 5min.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Persist request logs in the CF dashboard so "繋がらない" reports can be
  // debugged after the fact (which token, which status, when).
  "observability": {
    "enabled": true
  }
  // Secrets (NOT vars), set with `wrangler secret put <NAME>`:
  //   MCP_TOKEN, RT_SECRET, PUSH_SECRET (same value as the main app's), OAUTH_SECRET
}
